---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";

interface PantryProduct {
  id: string;
  name: string;
  quantity: number;
  unit: string;
  min_threshold: number;
}

interface ManualItem {
  id: string;
  name: string;
  quantity: number;
  unit: string;
}

interface MergedItem {
  id: string;
  name: string;
  buy: number;
  unit: string;
  type: "pantry" | "manual";
}

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
let items: MergedItem[] = [];

if (user && supabase) {
  const [productsResult, manualResult] = await Promise.all([
    supabase
      .from("products")
      .select("id, name, quantity, unit, min_threshold")
      .eq("add_to_list", true)
      .order("name", { ascending: true }),
    supabase.from("shopping_list_items").select("id, name, quantity, unit").order("name", { ascending: true }),
  ]);

  if (productsResult.error) {
    return Astro.redirect(`/shopping-list?error=${encodeURIComponent(productsResult.error.message)}`);
  }
  if (manualResult.error) {
    return Astro.redirect(`/shopping-list?error=${encodeURIComponent(manualResult.error.message)}`);
  }

  const pantryItems = (productsResult.data as PantryProduct[])
    .filter((p) => p.quantity < p.min_threshold)
    .map((p) => ({
      id: p.id,
      name: p.name,
      buy: p.min_threshold - p.quantity,
      unit: p.unit,
      type: "pantry" as const,
    }));

  const manualItems = (manualResult.data as ManualItem[]).map((i) => ({
    id: i.id,
    name: i.name,
    buy: i.quantity,
    unit: i.unit,
    type: "manual" as const,
  }));

  items = [...pantryItems, ...manualItems].sort((a, b) => a.name.localeCompare(b.name));
}

const rawError = Astro.url.searchParams.get("error");
const error = rawError
  ? (() => {
      try {
        return decodeURIComponent(rawError);
      } catch {
        return rawError;
      }
    })()
  : null;
---

<Layout title="Shopping List">
  <div class="bg-cosmic min-h-screen p-6 text-white">
    <div class="mx-auto max-w-4xl">
      <Topbar />
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Shopping List
        </h1>
        <a
          href="/shopping-list/new"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          + Add item
        </a>
      </div>

      {
        error && (
          <div class="mb-4 rounded-lg border border-red-400/30 bg-red-400/10 px-4 py-3 text-sm text-red-300">
            {error}
          </div>
        )
      }

      {
        items.length === 0 ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center backdrop-blur-xl">
            <p class="text-blue-100/60">Your pantry is fully stocked.</p>
            <a href="/inventory" class="mt-4 inline-block text-sm text-purple-300 hover:underline">
              Go to My Pantry →
            </a>
          </div>
        ) : (
          <div class="overflow-hidden rounded-2xl border border-white/10 backdrop-blur-xl">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-white/10 bg-white/5 text-left text-blue-100/60">
                  <th class="px-4 py-3 font-medium">Name</th>
                  <th class="px-4 py-3 font-medium">Buy</th>
                  <th class="px-4 py-3" />
                </tr>
              </thead>
              <tbody>
                {items.map((item) => (
                  <tr class="border-b border-white/5 last:border-0 hover:bg-white/5">
                    <td class="px-4 py-3 font-medium">{item.name}</td>
                    <td class="px-4 py-3 text-blue-100/80">
                      {item.buy} {item.unit}
                    </td>
                    <td class="px-4 py-3">
                      <div class="flex justify-end gap-2">
                        {item.type === "pantry" && (
                          <a
                            href={`/inventory/${item.id}/edit`}
                            aria-label={`Edit ${item.name}`}
                            class="rounded border border-white/20 px-2 py-1 text-xs hover:bg-white/10"
                          >
                            Edit
                          </a>
                        )}
                        <button
                          class="checkoff-trigger rounded border border-green-400/30 px-2 py-1 text-xs text-green-400 hover:bg-green-400/10"
                          data-item-id={item.id}
                          data-item-name={item.name}
                          data-item-type={item.type}
                          data-buy-amount={item.buy}
                          data-unit={item.unit}
                          aria-label={`Check off ${item.name}`}
                        >
                          Check off
                        </button>
                        <button
                          class="delete-trigger rounded border border-red-400/30 px-2 py-1 text-xs text-red-400 hover:bg-red-400/10"
                          data-item-id={item.id}
                          data-item-name={item.name}
                          data-item-type={item.type}
                          aria-label={`Delete ${item.name}`}
                        >
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>

  <!-- Delete confirmation dialog (both pantry + manual) -->
  <dialog
    id="delete-dialog"
    aria-labelledby="delete-dialog-title"
    class="w-full max-w-sm rounded-2xl border border-white/10 bg-gray-900 p-6 text-white shadow-xl backdrop:bg-black/50"
  >
    <h2 id="delete-dialog-title" class="mb-2 text-lg font-semibold">Delete from list?</h2>
    <p class="mb-6 text-sm text-blue-100/70">
      Remove <strong id="delete-dialog-name"></strong> from your shopping list? This won't add it to your pantry.
    </p>
    <div class="flex gap-3">
      <button
        id="delete-cancel"
        class="flex-1 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
      >
        Cancel
      </button>
      <button
        id="delete-confirm"
        class="flex-1 rounded-lg bg-red-500 px-4 py-2 text-sm font-medium transition-colors hover:bg-red-600"
      >
        Delete
      </button>
    </div>
  </dialog>

  <!-- Check-off dialog (both pantry + manual) -->
  <dialog
    id="checkoff-dialog"
    aria-labelledby="checkoff-dialog-title"
    class="w-full max-w-sm rounded-2xl border border-white/10 bg-gray-900 p-6 text-white shadow-xl backdrop:bg-black/50"
  >
    <h2 id="checkoff-dialog-title" class="mb-2 text-lg font-semibold">How much did you buy?</h2>
    <p class="mb-4 text-sm text-blue-100/70">
      Record how much <strong id="checkoff-dialog-name"></strong> you bought — your pantry will update.
    </p>
    <div class="space-y-4">
      <div class="flex gap-3">
        <div class="flex-1">
          <label for="checkoff-qty" class="mb-1 block text-sm text-blue-100/80">How many *</label>
          <input
            id="checkoff-qty"
            type="number"
            min="0.01"
            step="any"
            class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/30 focus:ring-2 focus:ring-purple-400 focus:outline-none"
          />
        </div>
        <div class="flex-1">
          <label for="checkoff-unit" class="mb-1 block text-sm text-blue-100/80">Unit *</label>
          <input
            id="checkoff-unit"
            type="text"
            class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/30 focus:ring-2 focus:ring-purple-400 focus:outline-none"
          />
        </div>
      </div>
      <p id="checkoff-conversion-msg" class="hidden text-xs"></p>
      <div>
        <label for="checkoff-expiry" class="mb-1 block text-sm text-blue-100/80"
          >Expiry date <span class="text-blue-100/40">(optional)</span></label
        >
        <input
          id="checkoff-expiry"
          type="date"
          class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
        />
      </div>
      <div class="border-t border-white/10 pt-3">
        <label class="flex cursor-pointer items-center gap-2 text-sm text-blue-100/70">
          <input id="checkoff-add-to-list" type="checkbox" class="h-4 w-4 rounded accent-purple-400" />
          Add to shopping list when below threshold
        </label>
        <div id="checkoff-threshold-row" class="mt-3 hidden">
          <label for="checkoff-min-threshold" class="mb-1 block text-sm text-blue-100/80">Min threshold</label>
          <input
            id="checkoff-min-threshold"
            type="number"
            min="0"
            step="any"
            class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/30 focus:ring-2 focus:ring-purple-400 focus:outline-none"
            placeholder="0"
          />
        </div>
      </div>
    </div>
    <div class="mt-6 flex gap-3">
      <button
        id="checkoff-cancel"
        class="flex-1 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
      >
        Cancel
      </button>
      <button
        id="checkoff-confirm"
        class="flex-1 rounded-lg bg-purple-500 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-600"
      >
        Confirm
      </button>
    </div>
  </dialog>
</Layout>

<script>
  import { convertUnit } from "@/lib/units";

  // ── Delete dialog ──────────────────────────────────────────────────
  const deleteDialog = document.getElementById("delete-dialog") as HTMLDialogElement | null;
  const deleteNameEl = document.getElementById("delete-dialog-name");
  const deleteCancelBtn = document.getElementById("delete-cancel");
  const deleteConfirmBtn = document.getElementById("delete-confirm");
  let deletePendingId: string | null = null;
  let deletePendingType: string | null = null;
  let deletePendingTrigger: HTMLButtonElement | null = null;

  document.querySelectorAll<HTMLButtonElement>(".delete-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      deletePendingTrigger = btn;
      deletePendingId = btn.dataset.itemId ?? null;
      deletePendingType = btn.dataset.itemType ?? null;
      if (deleteNameEl) deleteNameEl.textContent = btn.dataset.itemName ?? "";
      deleteDialog?.showModal();
    });
  });

  deleteCancelBtn?.addEventListener("click", () => {
    deleteDialog?.close();
  });

  deleteDialog?.addEventListener("click", (e) => {
    if (e.target === deleteDialog) deleteDialog.close();
  });

  deleteDialog?.addEventListener("close", () => {
    deletePendingTrigger?.focus();
    deletePendingTrigger = null;
    deletePendingId = null;
    deletePendingType = null;
  });

  deleteConfirmBtn?.addEventListener("click", async () => {
    if (!deletePendingId) return;
    const id = deletePendingId;
    const type = deletePendingType;
    deleteDialog?.close();

    let response: Response;
    if (type === "pantry") {
      response = await fetch(`/api/products/${id}/unlist`, { method: "POST" });
    } else {
      response = await fetch(`/api/shopping-list-items/${id}`, { method: "DELETE" });
    }

    if (response.ok) {
      window.location.href = "/shopping-list";
    } else {
      const errorMsg = await response.text();
      window.location.href = `/shopping-list?error=${encodeURIComponent(errorMsg)}`;
    }
  });

  // ── Check-off dialog ───────────────────────────────────────────────
  const checkoffDialog = document.getElementById("checkoff-dialog") as HTMLDialogElement | null;
  const checkoffNameEl = document.getElementById("checkoff-dialog-name");
  const checkoffQtyInput = document.getElementById("checkoff-qty") as HTMLInputElement | null;
  const checkoffUnitInput = document.getElementById("checkoff-unit") as HTMLInputElement | null;
  const checkoffConversionMsg = document.getElementById("checkoff-conversion-msg");
  const checkoffExpiryInput = document.getElementById("checkoff-expiry") as HTMLInputElement | null;
  const checkoffAddToListCheckbox = document.getElementById("checkoff-add-to-list") as HTMLInputElement | null;
  const checkoffThresholdRow = document.getElementById("checkoff-threshold-row");
  const checkoffMinThresholdInput = document.getElementById("checkoff-min-threshold") as HTMLInputElement | null;
  const checkoffCancelBtn = document.getElementById("checkoff-cancel");
  const checkoffConfirmBtn = document.getElementById("checkoff-confirm") as HTMLButtonElement | null;
  let checkoffPendingId: string | null = null;
  let checkoffPendingType: string | null = null;
  let checkoffPendingItemUnit = "";
  let checkoffPendingTrigger: HTMLButtonElement | null = null;

  function updateConversionPreview() {
    if (!checkoffConversionMsg || !checkoffQtyInput || !checkoffUnitInput) return;
    const qty = parseFloat(checkoffQtyInput.value);
    const entered = checkoffUnitInput.value.trim();
    const target = checkoffPendingItemUnit;

    const hide = () => {
      checkoffConversionMsg.textContent = "";
      checkoffConversionMsg.className = "hidden text-xs";
      if (checkoffConfirmBtn) checkoffConfirmBtn.disabled = false;
    };

    if (!entered || isNaN(qty) || !target || entered.toLowerCase() === target.toLowerCase()) {
      hide();
      return;
    }

    const converted = convertUnit(qty, entered, target);
    if (converted === null) {
      checkoffConversionMsg.textContent = `Cannot convert ${entered} to ${target}`;
      checkoffConversionMsg.className = "text-xs mt-1 text-red-400";
      if (checkoffConfirmBtn) checkoffConfirmBtn.disabled = true;
    } else {
      const rounded = Math.round(converted * 10000) / 10000;
      checkoffConversionMsg.textContent = `≈ ${rounded} ${target} will be added to your pantry`;
      checkoffConversionMsg.className = "text-xs mt-1 text-blue-100/60";
      if (checkoffConfirmBtn) checkoffConfirmBtn.disabled = false;
    }
  }

  checkoffAddToListCheckbox?.addEventListener("change", () => {
    if (checkoffAddToListCheckbox.checked) {
      checkoffThresholdRow?.classList.remove("hidden");
    } else {
      checkoffThresholdRow?.classList.add("hidden");
      if (checkoffMinThresholdInput) checkoffMinThresholdInput.value = "";
    }
  });

  checkoffQtyInput?.addEventListener("input", updateConversionPreview);
  checkoffUnitInput?.addEventListener("input", updateConversionPreview);

  document.querySelectorAll<HTMLButtonElement>(".checkoff-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      checkoffPendingTrigger = btn;
      checkoffPendingId = btn.dataset.itemId ?? null;
      checkoffPendingType = btn.dataset.itemType ?? null;
      checkoffPendingItemUnit = btn.dataset.unit ?? "";
      if (checkoffNameEl) checkoffNameEl.textContent = btn.dataset.itemName ?? "";
      if (checkoffQtyInput) {
        checkoffQtyInput.value = "";
        checkoffQtyInput.placeholder = `e.g. ${btn.dataset.buyAmount ?? ""}`;
      }
      if (checkoffUnitInput) checkoffUnitInput.value = btn.dataset.unit ?? "";
      if (checkoffConversionMsg) {
        checkoffConversionMsg.textContent = "";
        checkoffConversionMsg.className = "hidden text-xs";
      }
      checkoffDialog?.showModal();
    });
  });

  checkoffCancelBtn?.addEventListener("click", () => {
    checkoffDialog?.close();
  });

  checkoffDialog?.addEventListener("click", (e) => {
    if (e.target === checkoffDialog) checkoffDialog.close();
  });

  checkoffDialog?.addEventListener("close", () => {
    checkoffPendingTrigger?.focus();
    checkoffPendingTrigger = null;
    checkoffPendingId = null;
    checkoffPendingType = null;
    checkoffPendingItemUnit = "";
    if (checkoffQtyInput) checkoffQtyInput.value = "";
    if (checkoffUnitInput) checkoffUnitInput.value = "";
    if (checkoffConversionMsg) {
      checkoffConversionMsg.textContent = "";
      checkoffConversionMsg.className = "hidden text-xs";
    }
    if (checkoffConfirmBtn) checkoffConfirmBtn.disabled = false;
    if (checkoffExpiryInput) checkoffExpiryInput.value = "";
    if (checkoffAddToListCheckbox) checkoffAddToListCheckbox.checked = false;
    checkoffThresholdRow?.classList.add("hidden");
    if (checkoffMinThresholdInput) checkoffMinThresholdInput.value = "";
  });

  checkoffConfirmBtn?.addEventListener("click", async () => {
    if (!checkoffPendingId || !checkoffQtyInput || !checkoffUnitInput) return;
    const id = checkoffPendingId;
    const type = checkoffPendingType;
    const formData = new FormData();
    formData.set("qty_purchased", checkoffQtyInput.value);
    formData.set("qty_unit", checkoffUnitInput.value.trim());
    if (checkoffExpiryInput?.value) formData.set("expiry_date", checkoffExpiryInput.value);
    if (checkoffAddToListCheckbox?.checked) {
      formData.set("add_to_list", "on");
      if (checkoffMinThresholdInput?.value) formData.set("min_threshold", checkoffMinThresholdInput.value);
    }
    checkoffDialog?.close();

    const url = type === "pantry" ? `/api/products/${id}/checkoff` : `/api/shopping-list-items/${id}/checkoff`;
    const response = await fetch(url, { method: "POST", body: formData });

    if (response.ok) {
      window.location.href = "/shopping-list";
    } else {
      const errorMsg = await response.text();
      window.location.href = `/shopping-list?error=${encodeURIComponent(errorMsg)}`;
    }
  });
</script>
