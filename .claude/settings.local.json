{
  "permissions": {
    "allow": ["WebSearch"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --fix . --quiet",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "npx tsc --noEmit",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": "bash -c 'FILE=$(jq -r .tool_input.file_path) && npx vitest related \"$FILE\" --run'",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
