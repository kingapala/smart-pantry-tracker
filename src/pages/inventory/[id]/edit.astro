---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";

interface ProductRow {
  id: string;
  name: string;
  quantity: number;
  unit: string;
  expiry_date: string | null;
  min_threshold: number;
  add_to_list: boolean;
}

const { user } = Astro.locals;
const { id } = Astro.params;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase || !id || !user) {
  return new Response(null, { status: 302, headers: { Location: "/inventory" } });
}

const { data: product } = (await supabase
  .from("products")
  .select("*")
  .eq("id", id)
  .eq("user_id", user.id)
  .single()) as { data: ProductRow | null; error: unknown };

if (!product) {
  return new Response(null, { status: 302, headers: { Location: "/inventory" } });
}

const error = Astro.url.searchParams.get("error");
---

<Layout title="Edit product">
  <div class="bg-cosmic flex min-h-screen flex-col pt-4">
    <Topbar />
    <div class="flex flex-1 items-center justify-center p-4">
      <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Edit product
        </h1>

        {
          error && (
            <div class="mb-4 rounded-lg border border-red-400/30 bg-red-400/10 px-4 py-3 text-sm text-red-300">
              {decodeURIComponent(error)}
            </div>
          )
        }

        <form id="edit-form" method="post" class="space-y-4">
          <div>
            <label for="name" class="mb-1 block text-sm text-blue-100/80">Name *</label>
            <input
              id="name"
              name="name"
              type="text"
              required
              value={product.name}
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/30 focus:ring-2 focus:ring-purple-400 focus:outline-none"
            />
          </div>

          <div class="flex gap-3">
            <div class="flex-1">
              <label for="quantity" class="mb-1 block text-sm text-blue-100/80">Quantity *</label>
              <input
                id="quantity"
                name="quantity"
                type="number"
                min="0"
                step="any"
                required
                value={product.quantity}
                class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/30 focus:ring-2 focus:ring-purple-400 focus:outline-none"
              />
            </div>
            <div class="flex-1">
              <label for="unit" class="mb-1 block text-sm text-blue-100/80">Unit *</label>
              <input
                id="unit"
                name="unit"
                type="text"
                required
                value={product.unit}
                class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/30 focus:ring-2 focus:ring-purple-400 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="min_threshold" class="mb-1 block text-sm text-blue-100/80">Min threshold *</label>
            <input
              id="min_threshold"
              name="min_threshold"
              type="number"
              min="0"
              step="any"
              required
              value={product.min_threshold}
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/30 focus:ring-2 focus:ring-purple-400 focus:outline-none"
            />
          </div>

          <div>
            <label for="expiry_date" class="mb-1 block text-sm text-blue-100/80">Expiry date</label>
            <input
              id="expiry_date"
              name="expiry_date"
              type="date"
              value={product.expiry_date ?? ""}
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
            />
          </div>

          <label class="flex cursor-pointer items-center gap-3">
            <input
              name="add_to_list"
              type="checkbox"
              checked={product.add_to_list}
              class="h-4 w-4 rounded accent-purple-400"
            />
            <span class="text-sm text-blue-100/80">Add to shopping list when below threshold</span>
          </label>

          <div class="flex gap-3 pt-2">
            <button
              type="submit"
              class="flex-1 rounded-lg bg-purple-500 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-600"
            >
              Save changes
            </button>
            <a
              href="/inventory"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ productId: id }}>
  const form = document.getElementById("edit-form");
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const response = await fetch(`/api/products/${productId}`, {
        method: "PUT",
        body: new FormData(form),
      });
      if (response.ok) {
        window.location.href = "/inventory";
      } else {
        const errorMsg = await response.text();
        window.location.href = window.location.pathname + "?error=" + errorMsg;
      }
    });
  }
</script>
