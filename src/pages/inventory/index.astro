---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import { formatDateDisplay } from "@/lib/date";

interface Product {
  id: string;
  name: string;
  quantity: number;
  unit: string;
  expiry_date: string | null;
  min_threshold: number;
  add_to_list: boolean;
}

const { user } = Astro.locals;
const sortParam = Astro.url.searchParams.get("sort");
const supabase = createClient(Astro.request.headers, Astro.cookies);
let products: Product[] = [];
if (user && supabase) {
  const { data, error: listError } =
    sortParam === "expiry"
      ? await supabase.from("products").select("*").order("expiry_date", { ascending: true, nullsFirst: false })
      : await supabase.from("products").select("*").order("created_at", { ascending: true });
  if (listError) {
    return Astro.redirect(`/inventory?error=${encodeURIComponent(listError.message)}`);
  }
  products = data as Product[];
}

const rawError = Astro.url.searchParams.get("error");
const error = rawError
  ? (() => {
      try {
        return decodeURIComponent(rawError);
      } catch {
        return rawError;
      }
    })()
  : null;
---

<Layout title="My Pantry">
  <div class="bg-cosmic min-h-screen p-6 text-white">
    <div class="mx-auto max-w-4xl">
      <Topbar />
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          My Pantry
        </h1>
        <a
          href="/inventory/new"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          + Add product
        </a>
      </div>

      {
        error && (
          <div class="mb-4 rounded-lg border border-red-400/30 bg-red-400/10 px-4 py-3 text-sm text-red-300">
            {error}
          </div>
        )
      }

      {
        products.length === 0 ? (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center backdrop-blur-xl">
            <p class="text-blue-100/60">Your pantry is empty.</p>
            <a href="/inventory/new" class="mt-4 inline-block text-sm text-purple-300 hover:underline">
              Add your first product →
            </a>
          </div>
        ) : (
          <div class="overflow-hidden rounded-2xl border border-white/10 backdrop-blur-xl">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b border-white/10 bg-white/5 text-left text-blue-100/60">
                  <th class="px-4 py-3 font-medium">Name</th>
                  <th class="px-4 py-3 font-medium">Qty</th>
                  <th class="px-4 py-3 font-medium">Min</th>
                  <th class="px-4 py-3 font-medium">
                    {sortParam === "expiry" ? (
                      <span>Expiry ↑ <a href="/inventory" aria-label="Clear expiry sort" class="ml-1 opacity-60 hover:opacity-100">×</a></span>
                    ) : (
                      <a href="?sort=expiry" class="hover:underline">Expiry ↑</a>
                    )}
                  </th>
                  <th class="px-4 py-3 font-medium">On list</th>
                  <th class="px-4 py-3" />
                </tr>
              </thead>
              <tbody>
                {products.map((p) => (
                  <tr class="border-b border-white/5 last:border-0 hover:bg-white/5">
                    <td class="px-4 py-3 font-medium">{p.name}</td>
                    <td class="px-4 py-3 text-blue-100/80">
                      {p.quantity} {p.unit}
                    </td>
                    <td class="px-4 py-3 text-blue-100/80">
                      {p.min_threshold} {p.unit}
                    </td>
                    <td class="px-4 py-3 text-blue-100/80">{p.expiry_date ? formatDateDisplay(p.expiry_date) : "—"}</td>
                    <td class="px-4 py-3 text-center">
                      {p.add_to_list ? (
                        <span class="text-xs text-green-400">✓</span>
                      ) : (
                        <span class="text-xs text-blue-100/30">✗</span>
                      )}
                    </td>
                    <td class="px-4 py-3">
                      <div class="flex justify-end gap-2">
                        <a
                          href={`/inventory/${p.id}/edit`}
                          aria-label={`Edit ${p.name}`}
                          class="rounded border border-white/20 px-2 py-1 text-xs hover:bg-white/10"
                        >
                          Edit
                        </a>
                        <button
                          class="delete-trigger rounded border border-red-400/30 px-2 py-1 text-xs text-red-400 hover:bg-red-400/10"
                          data-product-id={p.id}
                          data-product-name={p.name}
                          aria-label={`Delete ${p.name}`}
                        >
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </div>

  <!-- Shared delete confirmation dialog -->
  <dialog
    id="delete-dialog"
    aria-labelledby="delete-dialog-title"
    class="w-full max-w-sm rounded-2xl border border-white/10 bg-gray-900 p-6 text-white shadow-xl backdrop:bg-black/50"
  >
    <h2 id="delete-dialog-title" class="mb-2 text-lg font-semibold">Delete product?</h2>
    <p class="mb-6 text-sm text-blue-100/70">
      This will permanently delete <strong id="delete-dialog-name"></strong>. This action cannot be undone.
    </p>
    <div class="flex gap-3">
      <button
        id="delete-cancel"
        class="flex-1 rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
      >
        Cancel
      </button>
      <button
        id="delete-confirm"
        class="flex-1 rounded-lg bg-red-500 px-4 py-2 text-sm font-medium transition-colors hover:bg-red-600"
      >
        Delete
      </button>
    </div>
  </dialog>
</Layout>

<script>
  const dialog = document.getElementById("delete-dialog") as HTMLDialogElement | null;
  const nameEl = document.getElementById("delete-dialog-name");
  const cancelBtn = document.getElementById("delete-cancel");
  const confirmBtn = document.getElementById("delete-confirm");
  let pendingId: string | null = null;
  let pendingTrigger: HTMLButtonElement | null = null;

  document.querySelectorAll<HTMLButtonElement>(".delete-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      pendingTrigger = btn;
      pendingId = btn.dataset.productId ?? null;
      if (nameEl) nameEl.textContent = btn.dataset.productName ?? "";
      dialog?.showModal();
    });
  });

  cancelBtn?.addEventListener("click", () => {
    dialog?.close();
    pendingId = null;
  });

  // Close on backdrop click
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Close on Escape (native dialog behaviour — redundant but explicit)
  dialog?.addEventListener("close", () => {
    pendingTrigger?.focus();
    pendingTrigger = null;
    pendingId = null;
  });

  confirmBtn?.addEventListener("click", async () => {
    if (!pendingId) return;
    const id = pendingId;
    dialog?.close();
    const response = await fetch(`/api/products/${id}`, { method: "DELETE" });
    if (response.ok) {
      window.location.href = "/inventory";
    } else {
      const errorMsg = await response.text();
      window.location.href = `/inventory?error=${encodeURIComponent(errorMsg)}`;
    }
  });
</script>
