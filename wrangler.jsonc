{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart-pantry-tracker",
  "compatibility_date": "2026-05-08",
  // nodejs_compat enables Node.js APIs in the workerd runtime.
  // disable_nodejs_process_v2 is the workaround for GitHub #15434:
  // without it, compatibility_date >= 2025-09-15 + nodejs_compat causes
  // middleware to return [object Object] instead of HTML responses.
  // If wrangler rejects this flag, replace with "no_nodejs_compat_v2".
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "b030d387e0eb4af3a56b0440b5612ca0", "preview_id": "d785769a6f5f405aa2fe8f3d5bc0da19" }
  ],
}
